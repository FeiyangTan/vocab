# Copy to .env.local and fill in real values. .env.local is not committed.
# On Vercel, set the same keys under Project Settings → Environment Variables.

# Neon — the pooled connection string (hostname contains -pooler), used at runtime
DATABASE_URL=

# Neon — the direct connection string (drop -pooler from the hostname); drizzle-kit
# migrations only
DATABASE_URL_DIRECT=

# Signs the login cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# The single password used to log in — pick your own
APP_PASSWORD=

# The token for POST /api/inbox?t=<this value>. Generate with: openssl rand -hex 24
INBOX_TOKEN=

# Only needed from Phase 4 on (calling the Claude API to draft); may be left empty for now
ANTHROPIC_API_KEY=

# The Bearer token Vercel Cron sends when calling /api/cron/backup.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Neon API key (for backups, creating branch snapshots).
# console.neon.tech → Account settings → API keys
NEON_API_KEY=

# Neon project ID. Neon console → project → Settings → General, e.g. dawn-sky-12345678
NEON_PROJECT_ID=
