# 复制成 .env.local 后填真实值。.env.local 不进 git。
# Vercel 上这几个要在 Project Settings → Environment Variables 里配同样的键。

# Neon —— pooled 连接串（主机名带 -pooler），应用运行时用
DATABASE_URL=

# Neon —— direct 连接串（把主机名里的 -pooler 去掉），只给 drizzle-kit 迁移用
DATABASE_URL_DIRECT=

# 签登录 cookie 用。生成：openssl rand -hex 32
AUTH_SECRET=

# 单密码登录的那个密码，自己定
APP_PASSWORD=

# POST /api/inbox?t=<这个值> 的 token。生成：openssl rand -hex 24
INBOX_TOKEN=

# Phase 4 才用到（调 Claude API 做整理），现在可以留空
ANTHROPIC_API_KEY=

# Vercel Cron 调 /api/cron/backup 时带的 Bearer。生成：openssl rand -hex 24
CRON_SECRET=

# Neon API key（备份用，建分支快照）。console.neon.tech → Account settings → API keys
NEON_API_KEY=

# Neon 项目 ID。Neon 面板 → 项目 → Settings → General，形如 dawn-sky-12345678
NEON_PROJECT_ID=
